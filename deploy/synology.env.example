# Place this file next to synology.compose.yaml, or pass it with --env-file.
# Do not commit the populated file.

POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

LLM_PROVIDER=deepseek
LLM_API_KEY=replace-me
LLM_BASE_URL=
LLM_FAST_MODEL=deepseek-flash
LLM_DEFAULT_MODEL=deepseek-v4-pro
LLM_REASONING_MODEL=deepseek-v4-pro

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
OLLAMA_EMBEDDING_DIMENSIONS=1024
WORKER_CONCURRENCY=1

# Override these only when the Synology LAN address or host port changes.
WEB_BIND_ADDRESS=192.168.50.66
WEB_PORT=8080

# Optional build mirror for Container Manager. Leave unset for the official PyPI.
# If the Synology cannot reach pypi.org reliably, configure a reachable mirror.
PIP_INDEX_URL=https://pypi.org/simple
