# Copy this file into your secret manager or deployment platform.
# Never commit the populated file. Compose only receives the rendered env file.
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ALLOWED_ORIGINS=["https://app.example.com"]
CSRF_ALLOWED_ORIGINS=["https://app.example.com"]
COOKIE_SECURE=true
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
DATABASE_URL=postgresql+asyncpg://interview:replace-me@postgres:5432/interview
REDIS_URL=redis://redis:6379/0
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-me
LLM_FAST_MODEL=deepseek-flash
LLM_DEFAULT_MODEL=deepseek-v4-pro
LLM_REASONING_MODEL=deepseek-v4-pro
RESUME_STORAGE_BACKEND=oss
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=replace-me-private
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=no-reply@example.com
PASSWORD_RESET_BASE_URL=https://app.example.com/reset-password
OPS_METRICS_TOKEN=replace-me
ALERT_WEBHOOK_URL=https://alerts.example.com/hooks/technical-interview-agent
ALERT_WEBHOOK_TOKEN=replace-me
ALERT_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
ALERT_HTTP_TIMEOUT_SECONDS=5
WORKER_CONCURRENCY=1
WORKER_MAX_RUNTIME_SECONDS=86400
WORKER_IDLE_SECONDS=1
WORKER_SHUTDOWN_GRACE_SECONDS=30
WORKER_HEALTH_FILE=/var/run/technical-interview-agent/worker-health.json
