# Render this file from the deployment platform or secret manager.
# It is consumed with: docker compose --env-file <this-file>
IMAGE_REPOSITORY=registry.example.com/technical-interview-agent
IMAGE_TAG=v0.1.0-rc.1
PRODUCTION_ENV_FILE=/secure/path/production.env

# Only required when the bundled postgres service is used.
POSTGRES_DB=interview
POSTGRES_USER=interview
POSTGRES_PASSWORD=replace-with-secret-manager-value

# Keep the API on loopback when TLS is terminated by a host reverse proxy.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
