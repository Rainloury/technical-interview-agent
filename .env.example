APP_NAME=technical-interview-agent
# staging/production startup requires LLM, SMTP and private OSS credentials,
# HTTPS reset URL, Secure cookies and non-localhost CORS/CSRF origins.
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_ALLOWED_ORIGINS=["http://127.0.0.1:3001"]

DATABASE_URL=postgresql+asyncpg://interview:interview@127.0.0.1:55432/interview
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_ECHO=false

REDIS_URL=redis://127.0.0.1:56379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2

SESSION_COOKIE_NAME=interview_session
CSRF_COOKIE_NAME=interview_csrf
COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_MINUTE=10
SESSION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=1800
CSRF_ALLOWED_ORIGINS=["http://127.0.0.1:3001"]
# 32-byte base64 key used only for reset-link delivery ciphertext.
DATA_ENCRYPTION_KEY=

# openai | anthropic | deepseek. `local` is an explicit non-deployment stub.
# For an OpenAI-compatible Chat Completions service, set LLM_PROVIDER=openai
# and LLM_BASE_URL to the full endpoint (ending in /chat/completions). The
# client derives the SDK root URL and consumes streamed responses. Set
# provider-specific model overrides only for enabled models.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_FAST_MODEL=deepseek-flash
LLM_DEFAULT_MODEL=deepseek-v4-pro
LLM_REASONING_MODEL=deepseek-v4-pro
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
OLLAMA_EMBEDDING_DIMENSIONS=1024
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_REQUEST_TIMEOUT_SECONDS=30
OLLAMA_MAX_RETRIES=2
RAG_EMBEDDING_BATCH_SIZE=16
PROMPT_DIR=app/prompts
TOOL_RESULT_MAX_CHARS=2000
TOOL_RESULT_DIR=/private/tmp/technical-interview-agent-tool-results
TOOL_RESULT_TTL_SECONDS=3600
OPS_METRICS_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
ALERT_HTTP_TIMEOUT_SECONDS=5

RESUME_STORAGE_BACKEND=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=resumes/

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
MAIL_LOCAL_RESET_FILE=/private/tmp/technical-interview-agent-password-reset.json
PASSWORD_RESET_BASE_URL=http://127.0.0.1:3001/reset-password

WORKER_CONCURRENCY=1
WORKER_MAX_RUNTIME_SECONDS=86400
WORKER_IDLE_SECONDS=1
WORKER_SHUTDOWN_GRACE_SECONDS=30
WORKER_HEALTH_FILE=/var/run/technical-interview-agent/worker-health.json

